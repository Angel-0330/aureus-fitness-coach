# ============================================================================
# Copia este archivo a ".env.local" para desarrollo, y pon estos mismos
# valores como "secretos" en tu proveedor de despliegue para producción.
# NUNCA subas el archivo ".env.local" (ya está en .gitignore) ni compartas
# estos valores por chat/correo sin cifrar.
# ============================================================================

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...           # segura de exponer (respeta RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # SECRETA. Nunca al navegador.

# Supabase → Project Settings → Database → Connection string
# Usa el modo "Transaction pooler" (puerto 6543), no el directo (5432),
# porque los entornos serverless abren y cierran muchas conexiones rápido.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Generar con: openssl rand -base64 32
FIELD_ENCRYPTION_SECRET=

# Upstash Redis (rate limiting) → upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=
